.container {
  display: flex;
  flex-direction: column;
  padding: 24rpx 28rpx;
  min-height: 100vh;
}

/* 顶部 */
.header {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 24rpx;
}

.logo {
  font-size: 48rpx;
  margin-bottom: 4rpx;
}

.title {
  font-size: 32rpx;
  font-weight: 700;
  color: #333;
  margin-bottom: 4rpx;
}

.subtitle {
  font-size: 24rpx;
  color: #bbb;
}

/* 通用 */
.section-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #555;
  display: block;
}

.scene-header .section-label {
  margin-bottom: 0;
}

/* 场景选择（3列网格） */
.scene-section {
  margin-bottom: 16rpx;
}

.scene-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10rpx;
}

.scene-header-left {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.scene-selected-tag {
  font-size: 20rpx;
  color: #FF6B6B;
  background: #FFF0F0;
  padding: 2rpx 12rpx;
  border-radius: 20rpx;
  max-width: 140rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.scene-scroll-hint {
  font-size: 20rpx;
  color: #ccc;
}

.scene-grid-scroll {
  max-height: 480rpx;
  overflow-y: auto;
}

.scene-grid {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  gap: 12rpx;
}

.scene-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 8rpx;
  background: #fff;
  border-radius: 20rpx;
  border: 2rpx solid #f0f0f0;
  box-sizing: border-box;
}

.scene-card.active {
  border-color: #FF6B6B;
  background: linear-gradient(135deg, #FFF5F5, #FFF0F0);
  box-shadow: 0 4rpx 20rpx rgba(255, 107, 107, 0.15);
}

.scene-icon {
  font-size: 44rpx;
  display: block;
  margin-bottom: 8rpx;
}

.scene-name {
  font-size: 26rpx;
  font-weight: 600;
  color: #333;
  display: block;
  text-align: center;
}

/* 输入区 */
.input-section {
  width: 100%;
}

.input-header {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-bottom: 10rpx;
}

.placeholder-hint {
  font-size: 22rpx;
  color: #ccc;
}

.topic-input {
  width: 100%;
  min-height: 200rpx;
  padding: 24rpx;
  background: #fff;
  border-radius: 16rpx;
  font-size: 30rpx;
  color: #333;
  border: 2rpx solid #eee;
  box-sizing: border-box;
  margin-bottom: 24rpx;
}

.topic-input::placeholder {
  color: #ddd;
}

/* 配图 */
.upload-area {
  width: 100%;
  margin-bottom: 24rpx;
}

.upload-btns {
  display: flex;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.upload-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 16rpx;
  background: #fff;
  border-radius: 14rpx;
  border: 2rpx dashed #ddd;
}

.upload-icon {
  font-size: 32rpx;
  margin-right: 6rpx;
}

.upload-text {
  font-size: 26rpx;
  color: #999;
}

.upload-hint {
  display: block;
  font-size: 24rpx;
  color: #bbb;
  margin-bottom: 12rpx;
}

.image-preview {
  display: flex;
  gap: 16rpx;
  flex-wrap: wrap;
}

.preview-item {
  position: relative;
  width: 160rpx;
  height: 160rpx;
}

.preview-img {
  width: 100%;
  height: 100%;
  border-radius: 12rpx;
  object-fit: cover;
}

.delete-btn {
  position: absolute;
  top: -12rpx;
  right: -12rpx;
  width: 40rpx;
  height: 40rpx;
  background: rgba(0, 0, 0, 0.5);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.delete-icon {
  font-size: 36rpx;
  color: #fff;
  line-height: 1;
}

/* 房贷计算器 */
.calc-group {
  background: #fff;
  border-radius: 16rpx;
  padding: 8rpx 24rpx;
  margin-bottom: 24rpx;
  border: 2rpx solid #eee;
}

.calc-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 2rpx solid #f5f5f5;
}

.calc-row:last-child {
  border-bottom: none;
}

.calc-label {
  font-size: 28rpx;
  color: #555;
  flex-shrink: 0;
}

.calc-input-wrap {
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.calc-input {
  text-align: right;
  font-size: 30rpx;
  color: #333;
  min-width: 160rpx;
  padding: 4rpx 0;
}

.calc-unit {
  font-size: 24rpx;
  color: #bbb;
  width: 40rpx;
}

.calc-picker {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 30rpx;
  color: #333;
  min-width: 180rpx;
  justify-content: flex-end;
}

.calc-picker-arrow {
  font-size: 20rpx;
  color: #ccc;
}

/* 生成按钮 */
.generate-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
  font-size: 32rpx;
  font-weight: 500;
  background: linear-gradient(135deg, #FF6B6B, #FF4757) !important;
  border: none !important;
}

.generate-btn.disabled {
  opacity: 0.4;
}

/* 底部 */
.footer {
  margin-top: 32rpx;
  text-align: center;
}

.footer-text {
  font-size: 24rpx;
  color: #ddd;
}
