.container {
  display: flex;
  flex-direction: column;
  padding: 40rpx 32rpx;
  min-height: 100vh;
}

/* 顶部 */
.header {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 40rpx;
}

.logo {
  font-size: 64rpx;
  margin-bottom: 8rpx;
}

.title {
  font-size: 36rpx;
  font-weight: 700;
  color: #333;
  margin-bottom: 8rpx;
}

.subtitle {
  font-size: 26rpx;
  color: #bbb;
}

/* 通用 */
.section-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #555;
  margin-bottom: 20rpx;
  display: block;
}

/* 场景网格 */
.scene-section {
  margin-bottom: 32rpx;
}

.scene-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.scene-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx 20rpx;
  text-align: center;
  border: 2rpx solid #f0f0f0;
  transition: all 0.2s;
}

.scene-card.active {
  border-color: #FF6B6B;
  background: linear-gradient(135deg, #FFF5F5, #FFF0F0);
  box-shadow: 0 4rpx 20rpx rgba(255, 107, 107, 0.15);
}

.scene-icon {
  font-size: 48rpx;
  display: block;
  margin-bottom: 12rpx;
}

.scene-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  display: block;
  margin-bottom: 6rpx;
}

.scene-desc {
  font-size: 22rpx;
  color: #bbb;
  display: block;
}

/* 输入区 */
.input-section {
  width: 100%;
}

.input-header {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-bottom: 16rpx;
}

.placeholder-hint {
  font-size: 22rpx;
  color: #ccc;
}

.topic-input {
  width: 100%;
  min-height: 160rpx;
  padding: 28rpx;
  background: #fff;
  border-radius: 16rpx;
  font-size: 30rpx;
  color: #333;
  border: 2rpx solid #eee;
  box-sizing: border-box;
  margin-bottom: 32rpx;
}

.topic-input::placeholder {
  color: #ddd;
}

/* 配图 */
.upload-area {
  width: 100%;
  margin-bottom: 48rpx;
}

.upload-btns {
  display: flex;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.upload-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24rpx;
  background: #fff;
  border-radius: 16rpx;
  border: 2rpx dashed #ddd;
}

.upload-icon {
  font-size: 36rpx;
  margin-right: 8rpx;
}

.upload-text {
  font-size: 28rpx;
  color: #999;
}

.upload-hint {
  display: block;
  font-size: 24rpx;
  color: #bbb;
  margin-bottom: 12rpx;
}

.image-preview {
  display: flex;
  gap: 16rpx;
  flex-wrap: wrap;
}

.preview-item {
  position: relative;
  width: 160rpx;
  height: 160rpx;
}

.preview-img {
  width: 100%;
  height: 100%;
  border-radius: 12rpx;
  object-fit: cover;
}

.delete-btn {
  position: absolute;
  top: -12rpx;
  right: -12rpx;
  width: 40rpx;
  height: 40rpx;
  background: rgba(0, 0, 0, 0.5);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.delete-icon {
  font-size: 36rpx;
  color: #fff;
  line-height: 1;
}

/* 生成按钮 */
.generate-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
  font-size: 32rpx;
  font-weight: 500;
  background: linear-gradient(135deg, #FF6B6B, #FF4757) !important;
  border: none !important;
}

.generate-btn.disabled {
  opacity: 0.4;
}

/* 底部 */
.footer {
  margin-top: 60rpx;
  text-align: center;
}

.footer-text {
  font-size: 24rpx;
  color: #ddd;
}
